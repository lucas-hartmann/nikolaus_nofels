# Only used by netlify/functions/submission-created.mjs, which e-mails the
# print-ready A4 PDF of every form submission.
# Set the real values in the Netlify UI (Site configuration -> Environment
# variables), NEVER in a committed file. For local `netlify dev`, copy this
# file to `.env` (git-ignored).

# Gmail address that SENDS the mail
EMAIL_USER=sender@gmail.com

# Gmail App password for that account (16 chars).
# Google Account -> Security -> 2-Step Verification -> App passwords
EMAIL_PASS=xxxx xxxx xxxx xxxx

# Where the mail + PDF is delivered (defaults to EMAIL_USER)
NOTIFY_EMAIL=recipient@example.com
