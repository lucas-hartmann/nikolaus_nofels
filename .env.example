# These variables are only used by the Netlify function
# netlify/functions/submission-created.mjs, which e-mails the A4 PDF of each
# form submission. Set the real values in the Netlify UI
# (Site configuration -> Environment variables), NOT in a committed file.
#
# For local testing with `netlify dev`, copy this file to `.env`
# (which is git-ignored) and fill it in.

# Gmail account that SENDS the notification mail
EMAIL_USER=nofelsnikolaus@gmail.com

# Gmail App password for that account (16 chars, spaces optional).
# Create at: Google Account -> Security -> 2-Step Verification -> App passwords
EMAIL_PASS=xxxx xxxx xxxx xxxx

# Where the notification + PDF is sent (optional; defaults to EMAIL_USER)
NOTIFY_EMAIL=nikolaus.nofels@outlook.com
